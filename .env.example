# Copy this file to .env at the repository root (.env is not version-controlled) and fill in the values
# for your environment [cicd-pipeline.md "Secrets管理"]. compose.yml reads .env from the same directory
# automatically (this file lives at the repository root, next to compose.yml, for that reason).
#
#   cp .env.example .env

# --- Production MySQL (existing, NOT containerized by this project) ---------------------------------
# Point these at your existing Zabbix MySQL instance. This project never containerizes, upgrades, or
# migrates that database [project.md Mandated: preserve existing data / MySQL only].
DB_SERVER_HOST=
DB_SERVER_PORT=3306
MYSQL_USER=zabbix
MYSQL_PASSWORD=
MYSQL_DATABASE=zabbix

# build-and-test found a known limitation: zabbix-server's mariadb-connector-c always attempts TLS and
# never skips certificate verification for any DBTLSConnect value on this connector build ("verify_ca"
# is rejected outright as unsupported). It therefore cannot connect to a MySQL whose certificate isn't
# already trusted by the system CA bundle — including this project's own dev-mysql (self-signed cert)
# and many default MySQL/MariaDB installs. See test-results.md for the full investigation. If your
# production MySQL's certificate IS trusted (a real CA, not self-signed) and you want the connection
# encrypted, set:
#   ZBX_DBTLSCONNECT=required
# Leave both blank (default) to connect without requesting TLS.
ZBX_DBTLSCONNECT=
ZBX_DBTLSCAFILE=

# This project's own variable (not from the official image) to verify against dev-mysql specifically:
# trusts dev-mysql's self-signed CA at the OS level inside zabbix-server, working around the limitation
# above without touching Zabbix's own TLS config. Only meaningful when DB_SERVER_HOST=zabbix-dev-mysql.
TRUST_DB_CA_FILE=/var/lib/mysql-certs/ca.pem

# --- zabbix-web --------------------------------------------------------------------------------------
ZABBIX_WEB_PORT=8080
ZBX_SERVER_NAME=
PHP_TZ=UTC

# --- zabbix-agent2 -----------------------------------------------------------------------------------
ZBX_HOSTNAME=

# --- Image tag [tech-stack-decisions.md "イメージバージョン表記"] ------------------------------------
ZABBIX_IMAGE_TAG=5.0.47-php8

# --- dev-mysql (only used with `podman compose --profile dev up -d dev-mysql`) -----------------------
# A throwaway MySQL 8.4 instance for local verification only [FR6.2] — never used in production.
DEV_MYSQL_ROOT_PASSWORD=zabbix-dev-root
DEV_MYSQL_PORT=3306
