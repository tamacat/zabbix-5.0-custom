# Copy this file to .env at the repository root (.env is not version-controlled) and fill in the values
# for your environment [cicd-pipeline.md "Secrets管理"]. compose.yml reads .env from the same directory
# automatically (this file lives at the repository root, next to compose.yml, for that reason).
#
#   cp .env.example .env

# --- Production MySQL (existing, NOT containerized by this project) ---------------------------------
# Point these at your existing Zabbix MySQL instance. This project never containerizes, upgrades, or
# migrates that database [project.md Mandated: preserve existing data / MySQL only].
DB_SERVER_HOST=
DB_SERVER_PORT=3306
MYSQL_USER=zabbix
MYSQL_PASSWORD=
MYSQL_DATABASE=zabbix

# Leave both blank (default) to connect without TLS — works against any MySQL regardless of whether it
# happens to offer TLS itself, including this project's own dev-mysql (self-signed cert) and most
# default MySQL/MariaDB installs. If your production MySQL's certificate IS trusted by a real CA (not
# self-signed) and you want the connection encrypted and verified, set:
#   ZBX_DBTLSCONNECT=required
ZBX_DBTLSCONNECT=
ZBX_DBTLSCAFILE=

# Only meaningful together with ZBX_DBTLSCONNECT=required above (verified-encrypted connections) — trusts
# a CA at the OS level inside zabbix-server. Not needed for the default (TLS off) path. This project's
# own variable, not from the official image; only relevant when DB_SERVER_HOST=zabbix-dev-mysql and
# you've opted into the encrypted dev-mysql path (see compose.yml's dev-mysql service).
TRUST_DB_CA_FILE=/var/lib/mysql-certs/ca.pem

# --- zabbix-web --------------------------------------------------------------------------------------
ZABBIX_WEB_PORT=8080
ZBX_SERVER_NAME=
PHP_TZ=UTC

# --- zabbix-agent2 -----------------------------------------------------------------------------------
ZBX_HOSTNAME=

# --- zabbix-proxy (SQLite3) ---------------------------------------------------------------------------
# Optional component — comment out the zabbix-proxy service in compose.yml if you don't need a proxy.
ZABBIX_PROXY_PORT=10051
ZBX_PROXY_HOSTNAME=zabbix-proxy-sqlite3

# --- Image tag [tech-stack-decisions.md "イメージバージョン表記"] ------------------------------------
ZABBIX_IMAGE_TAG=5.0.47-custom

# --- dev-mysql (only used with `podman compose --profile dev up -d dev-mysql`) -----------------------
# A throwaway MySQL 8.4 instance for local verification only [FR6.2] — never used in production.
DEV_MYSQL_ROOT_PASSWORD=zabbix-dev-root
DEV_MYSQL_PORT=3306
